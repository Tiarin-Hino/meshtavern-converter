{
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "findings"],
  "properties": {
    "summary": { "type": "string" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["focus", "blocking", "file", "line", "problem", "suggestion"],
        "properties": {
          "focus": { "type": "string", "enum": ["simplicity", "coherence", "general"] },
          "blocking": { "type": "boolean" },
          "file": { "type": "string" },
          "line": { "type": "integer" },
          "problem": { "type": "string" },
          "suggestion": { "type": "string" }
        }
      }
    }
  }
}
